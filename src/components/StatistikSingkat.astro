---
const statistik = [
  { angka: "10", label: "Program keahlian pada beranda resmi" },
  { angka: "6", label: "Butir misi sekolah" },
  { angka: "2000", label: "Tahun pendirian yang tercantum" },
  { angka: "1999", label: "Tahun gedung mulai berdiri" }
];
---
<section aria-labelledby="judul-statistik" class="stats-section">
  <div class="kontainer-laman stats-inner">
    <div class="stats-intro">
      <p class="pita-bagian">Sekilas sekolah</p>
      <h2 id="judul-statistik" class="font-judul text-2xl md:text-3xl">Fakta dari publikasi sekolah</h2>
      <p>Ringkasan historis dan daftar program yang dipublikasikan pada situs resmi. Bukan statistik real-time.</p>
    </div>
    <div class="stats-grid">
      {statistik.map((s, i) => (
        <div class="stats-item">
          <span class="stats-index">0{i + 1}</span>
          <p class="stats-number">{s.angka}</p>
          <p class="stats-label">{s.label}</p>
        </div>
      ))}
    </div>
    <p class="stats-source">Sumber: <a href="https://www.smkn1mandau.sch.id/" target="_blank" rel="noopener noreferrer">beranda resmi</a> dan <a href="http://www.smkn1mandau.sch.id/2022/04/sejarah-sekolah.html" target="_blank" rel="noopener noreferrer">halaman sejarah sekolah</a>.</p>
  </div>
</section>

<style>
  .stats-section {
    position: relative;
    overflow: hidden;
    color: var(--text-primary);
    border-block: 1px solid var(--line-color);
    background: var(--surface);
  }
  .stats-inner {
    display: grid;
    grid-template-columns: .8fr 1.5fr;
    align-items: center;
    gap: 2rem 3rem;
    padding-block: 3.5rem;
  }
  .stats-intro h2 { margin: .7rem 0 .55rem; color: var(--text-primary); }
  .stats-intro > p:last-child {
    max-width: 290px;
    margin: 0;
    color: var(--text-muted);
    font-size: .9rem;
    line-height: 1.7;
  }
  .stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .stats-item {
    position: relative;
    min-width: 0;
    padding: .4rem 1.1rem;
    border-left: 1px solid var(--line-color);
  }
  .stats-index {
    color: var(--accent-color);
    font-family: "Azeret Mono Local", monospace;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .14em;
  }
  .stats-number {
    margin: .35rem 0 .15rem;
    color: var(--text-primary);
    font-family: "Archivo Local", sans-serif;
    font-size: clamp(1.5rem, 2.7vw, 2.2rem);
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .stats-label { margin: 0; color: var(--text-muted); font-size: .82rem; line-height: 1.5; }
  .stats-source { grid-column: 1 / -1; margin: 0; color: var(--text-muted); font-size: .76rem; }
  .stats-source a { color: var(--accent-color); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 850px) { .stats-inner { grid-template-columns: 1fr; gap: 1.8rem; } }
  @media (max-width: 560px) {
    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.4rem; }
    .stats-item:nth-child(odd) { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 360px) { .stats-item { padding-right: .65rem; } }
</style>
