---
const programKeahlian = [
  { nama: "Teknik Komputer dan Jaringan", singkatan: "TKJ", deskripsi: "Bidang komputer, sistem, dan jaringan.", warna: "ukir", nomor: "01" },
  { nama: "Teknik Audio Video", singkatan: "TAV", deskripsi: "Bidang perangkat dan teknologi audio-video.", warna: "malam", nomor: "02" },
  { nama: "Desain Pemodelan dan Informasi Bangunan", singkatan: "DPIB", deskripsi: "Bidang desain, pemodelan, dan informasi bangunan.", warna: "rimba", nomor: "03" }
];
---
<section id="program" aria-labelledby="judul-pratinjau-program" class="program-section">
  <div class="kontainer-laman">
    <div class="program-heading">
      <div>
        <p class="pita-bagian mb-3">Program keahlian</p>
        <h2 id="judul-pratinjau-program" class="font-judul text-3xl md:text-4xl mb-4">
          Ruang untuk mengasah kompetensi dan keterampilan
        </h2>
      </div>
      <p class="program-description leading-relaxed">
        Tiga contoh nama program dari daftar yang dipublikasikan di situs resmi. Deskripsi hanya menjelaskan bidang secara umum, bukan rincian kurikulum atau klaim program unggulan.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      {programKeahlian.map((p) => (
        <article class="program-card" style={`--aksen-kartu: var(--${p.warna});`}>
          <div class="program-card-top">
            <span class="program-number">{p.nomor}</span>
            <span class="program-code">{p.singkatan}</span>
          </div>
          <div class="program-card-line" aria-hidden="true"></div>
          <h3 class="font-judul text-xl mb-3">{p.nama}</h3>
          <p class="program-description text-sm leading-relaxed">{p.deskripsi}</p>
          <span class="program-card-foot">Nama tercantum di situs resmi</span>
        </article>
      ))}
    </div>

    <div class="program-action">
      <a href="/program" class="tombol tombol-garis">Jelajahi seluruh program <span aria-hidden="true">↗</span></a>
      <a href="https://www.smkn1mandau.sch.id/" target="_blank" rel="noopener noreferrer" class="source-link">Periksa sumber resmi ↗</a>
    </div>
  </div>
</section>

<style>
  .program-section {
    padding-block: clamp(4.5rem, 8vw, 7rem);
    color: var(--text-primary);
    background: var(--surface-muted);
  }
  .program-heading {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    align-items: end;
    gap: 3rem;
    max-width: 940px;
    margin-bottom: 2.6rem;
  }
  .program-heading h2 { max-width: 620px; color: var(--text-primary); }
  .program-description { color: var(--text-muted); }
  .program-card {
    position: relative;
    display: flex;
    min-height: 285px;
    flex-direction: column;
    overflow: hidden;
    padding: 1.65rem;
    border: 1px solid var(--line-color);
    border-top: 4px solid var(--aksen-kartu);
    border-radius: 1rem;
    color: var(--text-primary);
    background: var(--surface);
    box-shadow: 0 12px 34px rgba(9, 24, 58, .055);
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  }
  .program-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--aksen-kartu) 42%, var(--line-color));
    box-shadow: 0 18px 38px rgba(9, 24, 58, .1);
  }
  .program-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
  .program-number {
    color: var(--aksen-kartu);
    font-family: "Azeret Mono Local", monospace;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .15em;
  }
  .program-code {
    display: grid;
    min-width: 2.7rem;
    min-height: 2.7rem;
    place-items: center;
    padding: .4rem;
    border-radius: .8rem;
    color: var(--aksen-kartu);
    background: color-mix(in srgb, var(--aksen-kartu) 12%, var(--surface));
    font-size: .72rem;
    font-weight: 800;
  }
  .program-card-line { width: 2.5rem; height: 2px; margin-bottom: 1.3rem; background: var(--aksen-kartu); }
  .program-card h3 { color: var(--text-primary); }
  .program-card-foot {
    display: inline-block;
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--text-muted);
    font-family: "Azeret Mono Local", monospace;
    font-size: .68rem;
    letter-spacing: .04em;
  }
  .program-action { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  .source-link { color: var(--accent-color); font-size: .9rem; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 700px) {
    .program-heading { grid-template-columns: 1fr; gap: .5rem; margin-bottom: 2rem; }
    .program-card { min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .program-card { transition: none; } }
</style>
