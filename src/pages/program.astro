---
import LayoutUtama from "../layouts/LayoutUtama.astro";
import DaftarProgram from "../components/DaftarProgram.jsx";
import DaftarTeknologi from "../components/DaftarTeknologi.jsx";
---
<LayoutUtama
  judul="Program Keahlian — SMK Negeri 1 Mandau (Replika)"
  deskripsi="Daftar program keahlian yang tersedia di SMK Negeri 1 Mandau."
  halamanAktif="program"
>
  <section class="bg-gradient-to-br from-malam-deep to-rimba-dark text-white py-20">
    <div class="kontainer-laman max-w-[640px]">
      <p class="font-rapat text-sm tracking-wide text-ukir-light mb-4">Program keahlian</p>
      <h1 class="font-judul text-4xl md:text-5xl leading-tight mb-5">
        Pilih jalur keahlian sesuai minat Anda
      </h1>
      <p class="text-gading/85 leading-relaxed text-lg">
        Daftar nama program di bawah merujuk pada bagian “Program Keahlian” di situs resmi sekolah. Gunakan pencarian untuk menemukan nama atau singkatan program.
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="kontainer-laman">
      <DaftarProgram client:load />
      <p class="text-xs text-tinta-pudar mt-5">Sumber nama program: <a class="font-bold text-ukir hover:underline" href="https://www.smkn1mandau.sch.id/" target="_blank" rel="noopener noreferrer">beranda resmi SMKN 1 Mandau ↗</a>.</p>
    </div>
  </section>

  <section class="py-20 bg-gading border-y border-malam/10" aria-labelledby="judul-bahasa-pemrograman">
    <div class="kontainer-laman">
      <p class="pita-bagian mb-3">Referensi belajar mandiri</p>
      <h2 id="judul-bahasa-pemrograman" class="font-judul text-3xl md:text-4xl text-malam mb-4">
        Bahasa pemrograman & teknologi web
      </h2>
      <p class="max-w-3xl text-tinta-pudar leading-relaxed mb-9">
        Materi belajar mandiri — bukan daftar mata pelajaran resmi sekolah. Kenali fungsi setiap teknologi dan mulai dari dokumentasi resminya.
      </p>
      <DaftarTeknologi client:load />
      <p class="text-xs text-tinta-pudar mt-7">HTML adalah bahasa markup, CSS adalah bahasa stylesheet, dan SQL adalah bahasa kueri; ketiganya bukan bahasa pemrograman umum.</p>
    </div>
  </section>
</LayoutUtama>
