---
import NotifikasiReplika from "../components/NotifikasiReplika.jsx";
import Navigasi from "../components/Navigasi.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  judul: string;
  deskripsi: string;
  halamanAktif?: string;
}

const { judul, deskripsi, halamanAktif = "" } = Astro.props;
---
<!DOCTYPE html>
<html lang="id" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={deskripsi} />
    <meta name="theme-color" content="#09183a" />
    <meta name="color-scheme" content="light" />
    <title>{judul}</title>

    <link rel="preload" href="/fonts/Outfit_Complete(1)/Outfit_Complete/Fonts/OTF/Outfit-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Archivo_Complete/Archivo_Complete/Fonts/OTF/Archivo-Bold.otf" as="font" type="font/otf" crossorigin />

    <!-- Pemberitahuan replika: situs ini bukan kanal resmi sekolah. -->
    <meta name="replika-situs" content="Ini adalah situs replika, bukan situs resmi. Situs asli: https://www.smkn1mandau.sch.id/?m=1" />
  </head>
  <body class="bg-kapas text-tinta font-badan">
    <NotifikasiReplika client:load />
    <Navigasi halamanAktif={halamanAktif} />
    <main id="konten-utama" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline src="/scripts/deteksi-fitur.js"></script>
    <script is:inline src="/scripts/i18n.js"></script>
  </body>
</html>
