---
import NotifikasiReplika from "../components/NotifikasiReplika.jsx";
import Navigasi from "../components/Navigasi.astro";
import Footer from "../components/Footer.astro";
import PencarianGlobal from "../components/PencarianGlobal.jsx";
import "../styles/global.css";
import "../styles/font-library.css";
import "../styles/theme-compat.css";
import "../styles/redesign.css";

interface Props {
  judul: string;
  deskripsi: string;
  halamanAktif?: string;
  indexable?: boolean;
}

const { judul, deskripsi, halamanAktif = "", indexable = true } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://smkn1mandau-replika-rtd.vercel.app").toString();
---
<!DOCTYPE html>
<html lang="id" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={deskripsi} />
    <meta name="robots" content={indexable ? "index, follow" : "noindex, nofollow"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SMK Negeri 1 Mandau — Replika" />
    <meta property="og:title" content={judul} />
    <meta property="og:description" content={deskripsi} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={judul} />
    <meta name="twitter:description" content={deskripsi} />
    <meta id="theme-color-meta" name="theme-color" content="#f5f7fa" />
    <meta name="color-scheme" content="light dark" />
    <title>{judul}</title>
    <script is:inline>
      (() => {
        const valid = ["light", "dark", "super-black", "amoled-black", "dynamic"];
        try {
          const saved = localStorage.getItem("smkn1mandau-theme");
          document.documentElement.dataset.theme = valid.includes(saved) ? saved : "light";
        } catch { document.documentElement.dataset.theme = "light"; }
      })();
    </script>

    <link rel="preload" href="/fonts/Outfit_Complete(1)/Outfit_Complete/Fonts/OTF/Outfit-Regular.otf" as="font" type="font/otf" crossorigin />

    <!-- Pemberitahuan replika: situs ini bukan kanal resmi sekolah. -->
    <meta name="replika-situs" content="Ini adalah situs replika, bukan situs resmi. Situs asli: https://www.smkn1mandau.sch.id/?m=1" />
  </head>
  <body class="bg-kapas text-tinta font-badan">
    <NotifikasiReplika client:load />
    <Navigasi halamanAktif={halamanAktif} />
    <PencarianGlobal client:idle />
    <main id="konten-utama" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline src="/scripts/deteksi-fitur.js"></script>
    <script is:inline src="/scripts/i18n.js"></script>
    <script is:inline src="/scripts/locale-dates.js" defer></script>
    <script>
      type Theme = "light" | "dark" | "super-black" | "amoled-black" | "dynamic";
      const key = "smkn1mandau-theme";
      const valid = (value: string): value is Theme => ["light","dark","super-black","amoled-black","dynamic"].includes(value);
      const root = document.documentElement;
      const apply = (theme: Theme, save = false) => {
        root.dataset.theme = theme;
        root.style.colorScheme = theme === "light" ? "light" : theme === "dynamic" ? "light dark" : "dark";
        document.querySelectorAll<HTMLSelectElement>("[data-theme-picker]").forEach((el) => { el.value = theme; });
        const status = document.querySelector<HTMLElement>("[data-theme-status]");
        if (status) status.textContent = `Tema aktif: ${theme.replaceAll("-", " ")}.`;
        const meta = document.querySelector<HTMLMetaElement>("#theme-color-meta");
        if (meta) meta.content = ({light:"#f5f7fa",dark:"#171b24","super-black":"#080b10","amoled-black":"#000000",dynamic:"Canvas"} as Record<Theme,string>)[theme];
        if (save) { try { localStorage.setItem(key, theme); } catch { /* Theme remains active for this view. */ } }
      };
      const initial = root.dataset.theme ?? "light";
      apply(valid(initial) ? initial : "light");
      document.querySelectorAll<HTMLSelectElement>("[data-theme-picker]").forEach((el) => el.addEventListener("change", () => { if (valid(el.value)) apply(el.value, true); }));
      window.addEventListener("storage", (event: StorageEvent) => { if (event.key === key && event.newValue && valid(event.newValue)) apply(event.newValue); });
    </script>
  </body>
</html>
